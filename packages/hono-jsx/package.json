{
  "name": "@nkfr26/inertia-hono-jsx",
  "version": "3.6.1",
  "license": "MIT",
  "description": "The Hono JSX adapter for Inertia.js",
  "contributors": [
    "Jonathan Reinink <jonathan@reinink.ca>",
    "Sebastian De Deyne <sebastiandedeyne@gmail.com>",
    "Ryuta Fukanoki <n@rfu.jp>"
  ],
  "homepage": "https://inertiajs.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkfr26/inertia.git",
    "directory": "packages/hono-jsx"
  },
  "bugs": {
    "url": "https://github.com/nkfr26/inertia/issues"
  },
  "files": [
    "dist",
    "types",
    "resources"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "types/server.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "pnpm clean && ./build.js && tsc",
    "build:with-deps": "./build.js --with-deps",
    "clean": "rm -rf types && rm -rf dist",
    "dev": "pnpx concurrently -c \"#ffcf00,#3178c6\" \"pnpm dev:build\" \"pnpm dev:types\" --names build,types",
    "dev:build": "./build.js --watch",
    "dev:types": "tsc --watch --preserveWatchOutput",
    "es2022-check": "pnpm build:with-deps && es-check es2022 \"dist/index.js\" --checkFeatures --module --noCache --verbose"
  },
  "devDependencies": {
    "axios": "^1.17.0",
    "es-check": "^9.6.1",
    "esbuild": "^0.28.1",
    "esbuild-node-externals": "^1.23.1",
    "hono": "^4.13.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "hono": "^4.13.0"
  },
  "dependencies": {
    "@inertiajs/core": "workspace:*",
    "es-toolkit": "^1.33.0",
    "laravel-precognition": "^2.0.0"
  }
}
